{
  "name": "dsh-github-sync",
  "version": "0.5.1",
  "description": "Sync DSH sessions and workspace files to a private GitHub repository, for hand-over between machines.",
  "type": "module",
  "license": "MIT",
  "author": "mount9527",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z1131392774/dsh-github-sync.git"
  },
  "homepage": "https://github.com/z1131392774/dsh-github-sync#readme",
  "bugs": {
    "url": "https://github.com/z1131392774/dsh-github-sync/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "sync",
    "cross-device",
    "handoff"
  ],
  "engines": {
    "node": ">=22.15.0",
    "dsh": ">=0.2.1-rc.5"
  },
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "lib/*.mjs",
    "README.md",
    "README_zh.md",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "LICENSE",
    "docs/*.md",
    "docs/*.png"
  ],
  "scripts": {
    "check": "node scripts/check-docs.mjs",
    "test": "node tools/selftest.mjs && node tools/test-upload-plan.mjs && node tools/test-force.mjs && node tools/test-multidevice.mjs && node tools/test-crossplatform.mjs && node tools/test-guards.mjs && node tools/test-filesync.mjs && node tools/test-boundaries.mjs && node tools/audit-safety.mjs && node tools/test-render.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
